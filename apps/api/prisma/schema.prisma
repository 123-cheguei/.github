// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADVERTISER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  PHOTO
  VIDEO
}

// ============================================
// USER MODEL
// ============================================
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole @default(CLIENT)
  
  // Verificação
  isVerified       Boolean  @default(false)
  verificationData Json?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?
  
  // Relations
  profile    Profile?
  reviews    Review[]
  favorites  Favorite[]
  auditLogs  AuditLog[]
  
  @@map("users")
}

// ============================================
// PROFILE MODEL (Anunciantes)
// ============================================
model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Informações públicas
  displayName String
  description String?  @db.Text
  location    String?
  
  // Dados estruturados
  services    Json?    // Array de serviços oferecidos
  pricing     Json?    // Estrutura de preços
  availability Json?   // Calendário de disponibilidade
  
  // Status
  verificationStatus VerificationStatus @default(PENDING)
  isActive           Boolean            @default(true)
  
  // Estatísticas
  viewCount    Int @default(0)
  contactCount Int @default(0)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  media    Media[]
  reviews  Review[]
  favorites Favorite[]
  
  @@map("profiles")
}

// ============================================
// MEDIA MODEL
// ============================================
model Media {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  type      MediaType
  url       String
  thumbnailUrl String?
  
  // Moderação
  moderationStatus ModerationStatus @default(PENDING)
  moderationNotes  String?
  
  // Metadata
  order    Int
  metadata Json?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("media")
}

// ============================================
// REVIEW MODEL
// ============================================
model Review {
  id        String   @id @default(uuid())
  
  clientId  String
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  // Review
  rating    Int      // 1-5
  comment   String?  @db.Text
  
  // Status
  isVerified       Boolean          @default(false)
  moderationStatus ModerationStatus @default(PENDING)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([clientId, profileId])
  @@map("reviews")
}

// ============================================
// FAVORITE MODEL
// ============================================
model Favorite {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, profileId])
  @@map("favorites")
}

// ============================================
// AUDIT LOG MODEL
// ============================================
model AuditLog {
  id        String   @id @default(uuid())
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Ação
  action     String
  resource   String
  resourceId String?
  
  // Dados
  changes    Json?
  
  // Context
  ipAddress  String?
  userAgent  String?
  
  createdAt  DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
